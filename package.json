{
  "name": "Pearson",
  "private": true,
  "scripts": {
    "dev:api": "cd apps/api && pnpm run start:dev",
    "dev:agent": "cd services/agent && uv run fastapi dev main.py",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "prettier": "3.9.6",
    "tsx": "^4.23.15",
    "turbo": "^2.11.5",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.23.1"
  }
}
